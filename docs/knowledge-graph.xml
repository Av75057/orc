    <UseCase id="UC-06"><Name>Deterministic verification</Name><Modules><Ref>M-TESTS</Ref></Modules></UseCase>
  </UseCases>

  <Invariants>
    <Invariant id="INV-01">Every event delivered to all subscribers exactly once</Invariant>
    <Invariant id="INV-02">Thermostat.is_on == True iff temp &lt; threshold</Invariant>
    <Invariant id="INV-03">LightBulb.is_on == True iff motion == True</Invariant>
    <Invariant id="INV-04">EventBus does not lose subscribers during publish</Invariant>
    <Invariant id="INV-05">Controller does not modify EventBus directly</Invariant>
    <Invariant id="INV-06">Event is immutable</Invariant>
  </Invariants>

  <Defects>
    <Defect id="DEFECT-01"><Description>Sync delivery blocks on slow subscriber</Description><Status>accepted</Status></Defect>
    <Defect id="DEFECT-02"><Description>No sensor calibration</Description><Status>accepted</Status></Defect>
  </Defects>


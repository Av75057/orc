  <UseCases>
    <UseCase id="UC-01"><Name>Event publish/subscribe</Name><Modules><Ref>M-EVENTBUS</Ref><Ref>M-MODELS</Ref></Modules><Invariants><Ref>INV-01</Ref><Ref>INV-04</Ref><Ref>INV-06</Ref></Invariants></UseCase>
    <UseCase id="UC-02"><Name>Temperature monitoring + thermostat</Name><Modules><Ref>M-SENSORS</Ref><Ref>M-ACTUATORS</Ref></Modules><Invariants><Ref>INV-01</Ref><Ref>INV-02</Ref></Invariants></UseCase>
    <UseCase id="UC-03"><Name>Motion detection + light control</Name><Modules><Ref>M-SENSORS</Ref><Ref>M-ACTUATORS</Ref></Modules><Invariants><Ref>INV-01</Ref><Ref>INV-03</Ref></Invariants></UseCase>

<DevelopmentPlan>
  <Phase id="PHASE-1">
    <Goal>Initial setup.</Goal>
    <Wave id="WAVE-1">
      <Goal>Create main application entry point.</Goal>
      <ModuleRef id="M-APP" />
      <AllowedWriteScope>
        <File>src/app.py</File>
        <File>tests/test_app.py</File>
      </AllowedWriteScope>
      <FrozenScope>
        <File>src/grace/*</File>
      </FrozenScope>
      <Verification>
        <Command>python -m pytest tests/test_app.py -v</Command>
      </Verification>
      <AcceptanceCriteria>
        <Criterion>App starts and responds to health check.</Criterion>
      </AcceptanceCriteria>
    </Wave>
  </Phase>
</DevelopmentPlan>

<?xml version="1.0" encoding="UTF-8"?>
<DevelopmentPlan>
  <Phase id="PHASE-INVENTORY">
    <Goal>Build an Inventory Management System with parallel operations and analytics.</Goal>

    <!-- WAVE 1: Foundation -->
    <Wave id="WAVE-CORE-1">
      <Goal>Create Product dataclass and Inventory class to store products.</Goal>
      <ModuleRef id="M-CORE" />
      <AllowedWriteScope>
        <File>src/models.py</File>
        <File>src/inventory.py</File>
        <File>tests/test_inventory.py</File>
      </AllowedWriteScope>
      <Verification>
        <Command>python -m pytest tests/test_inventory.py -v</Command>
      </Verification>
      <AcceptanceCriteria>
        <Criterion>models.py defines Product with id, name, price, quantity.</Criterion>
        <Criterion>inventory.py defines Inventory with add_product(product) and get_product(id).</Criterion>
      </AcceptanceCriteria>
    </Wave>

    <!-- WAVE 2: Parallel Operations -->
    <Wave id="WAVE-OPS-2">
      <Goal>Develop SalesManager and RestockManager in parallel.</Goal>
      
      <Slice id="SLICE-SALES">
        <Goal>Create sales.py with SalesManager class. It takes Inventory, and has sell(product_id, quantity) which decreases product quantity.</Goal>
        <ModuleRef id="M-SALES" />
        <AllowedWriteScope>
          <File>src/sales.py</File>
          <File>tests/test_sales.py</File>
        </AllowedWriteScope>
        <Verification>
          <Command>python -m pytest tests/test_sales.py -v</Command>
        </Verification>
        <AcceptanceCriteria>
          <Criterion>sales.py imports Inventory and Product.</Criterion>
          <Criterion>sell() method reduces quantity in Inventory.</Criterion>
        </AcceptanceCriteria>
      </Slice>

      <Slice id="SLICE-RESTOCK">
        <Goal>Create restock.py with RestockManager class. It takes Inventory, and has restock(product_id, quantity) which increases product quantity.</Goal>
        <ModuleRef id="M-RESTOCK" />
        <AllowedWriteScope>
          <File>src/restock.py</File>
          <File>tests/test_restock.py</File>
        </AllowedWriteScope>
        <Verification>
          <Command>python -m pytest tests/test_restock.py -v</Command>
        </Verification>
        <AcceptanceCriteria>
          <Criterion>restock.py imports Inventory and Product.</Criterion>
          <Criterion>restock() method increases quantity in Inventory.</Criterion>
        </AcceptanceCriteria>
      </Slice>
    </Wave>

    <!-- WAVE 3: Analytics Engine (Deep Context Injection) -->
    <Wave id="WAVE-ANALYTICS-3">
      <Goal>Create AnalyticsEngine that generates a report of total inventory value and stock levels.</Goal>
      <ModuleRef id="M-ANALYTICS" />
      <AllowedWriteScope>
        <File>src/analytics.py</File>
        <File>tests/test_analytics.py</File>
      </AllowedWriteScope>
      <FrozenScope>
        <File>src/models.py</File>
        <File>src/inventory.py</File>
        <File>src/sales.py</File>
        <File>src/restock.py</File>
      </FrozenScope>
      <Verification>
        <Command>python -m pytest tests/test_analytics.py -v</Command>
      </Verification>
      <AcceptanceCriteria>
        <Criterion>analytics.py imports Inventory.</Criterion>
        <Criterion>generate_report() returns a dict with 'total_value' (sum of price*quantity) and 'total_items'.</Criterion>
      </AcceptanceCriteria>
    </Wave>

    <!-- WAVE 4: Application -->
    <Wave id="WAVE-APP-4">
      <Goal>Create main.py that initializes inventory, runs sales/restock, and prints analytics report as JSON.</Goal>
      <ModuleRef id="M-APP" />
      <AllowedWriteScope>
        <File>src/main.py</File>
        <File>tests/test_main.py</File>
      </AllowedWriteScope>
      <FrozenScope>
        <File>src/models.py</File>
        <File>src/inventory.py</File>
        <File>src/sales.py</File>
        <File>src/restock.py</File>
        <File>src/analytics.py</File>
      </FrozenScope>
      <Verification>
        <Command>python -m pytest tests/test_main.py -v</Command>
      </Verification>
      <AcceptanceCriteria>
        <Criterion>main.py imports all modules and outputs valid JSON report.</Criterion>
      </AcceptanceCriteria>
    </Wave>
  </Phase>
</DevelopmentPlan>
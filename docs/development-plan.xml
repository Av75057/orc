<?xml version="1.0" encoding="UTF-8"?>
<DevelopmentPlan>
  <Phase id="PHASE-SMARTHOME">
    <Goal>Build an Event-Driven Smart Home Automation System.</Goal>

    <!-- WAVE 1: Event Bus & Models -->
    <Wave id="WAVE-CORE-1">
      <Goal>Create Device dataclass and an in-memory EventBus for pub/sub.</Goal>
      <ModuleRef id="M-CORE" />
      <AllowedWriteScope>
        <File>src/models.py</File>
        <File>src/event_bus.py</File>
        <File>tests/test_event_bus.py</File>
      </AllowedWriteScope>
      <Verification>
        <Command>python -m pytest tests/test_event_bus.py -v</Command>
      </Verification>
      <AcceptanceCriteria>
        <Criterion>models.py defines Device with id, name, and is_on boolean state.</Criterion>
        <Criterion>event_bus.py defines EventBus with subscribe(event_name, callback) and publish(event_name, data).</Criterion>
        <Criterion>publish triggers all subscribed callbacks with the data.</Criterion>
      </AcceptanceCriteria>
    </Wave>

    <!-- WAVE 2: Parallel Sensors (Publishers) -->
    <Wave id="WAVE-SENSORS-2">
      <Goal>Develop TemperatureSensor and MotionSensor that publish events to EventBus.</Goal>
      
      <Slice id="SLICE-TEMP">
        <Goal>Create temp_sensor.py with TemperatureSensor class. It reads temp and publishes 'temp_change'.</Goal>
        <ModuleRef id="M-TEMP" />
        <AllowedWriteScope>
          <File>src/temp_sensor.py</File>
          <File>tests/test_temp_sensor.py</File>
        </AllowedWriteScope>
        <Verification>
          <Command>python -m pytest tests/test_temp_sensor.py -v</Command>
        </Verification>
        <AcceptanceCriteria>
          <Criterion>TemperatureSensor takes EventBus in constructor.</Criterion>
          <Criterion>read(temp) method publishes 'temp_change' event with temp value.</Criterion>
        </AcceptanceCriteria>
      </Slice>

      <Slice id="SLICE-MOTION">
        <Goal>Create motion_sensor.py with MotionSensor class. It detects motion and publishes 'motion_detected'.</Goal>
        <ModuleRef id="M-MOTION" />
        <AllowedWriteScope>
          <File>src/motion_sensor.py</File>
          <File>tests/test_motion_sensor.py</File>
        </AllowedWriteScope>
        <Verification>
          <Command>python -m pytest tests/test_motion_sensor.py -v</Command>
        </Verification>
        <AcceptanceCriteria>
          <Criterion>MotionSensor takes EventBus in constructor.</Criterion>
          <Criterion>detect() method publishes 'motion_detected' event.</Criterion>
        </AcceptanceCriteria>
      </Slice>
    </Wave>

    <!-- WAVE 3: Parallel Actuators (Subscribers) -->
    <Wave id="WAVE-ACTUATORS-3">
      <Goal>Develop Thermostat and LightBulb that subscribe to events and change state.</Goal>
      
      <Slice id="SLICE-THERMO">
        <Goal>Create thermostat.py. Subscribes to 'temp_change'. If temp is less than 20, turns on heating (is_on=True).</Goal>
        <ModuleRef id="M-THERMO" />
        <AllowedWriteScope>
          <File>src/thermostat.py</File>
          <File>tests/test_thermostat.py</File>
        </AllowedWriteScope>
        <Verification>
          <Command>python -m pytest tests/test_thermostat.py -v</Command>
        </Verification>
        <AcceptanceCriteria>
          <Criterion>Thermostat subscribes to 'temp_change' on initialization.</Criterion>
          <Criterion>If event data temp is less than 20, device is_on becomes True.</Criterion>
        </AcceptanceCriteria>
      </Slice>

      <Slice id="SLICE-LIGHT">
        <Goal>Create light_bulb.py. Subscribes to 'motion_detected'. Turns on light (is_on=True) when motion occurs.</Goal>
        <ModuleRef id="M-LIGHT" />
        <AllowedWriteScope>
          <File>src/light_bulb.py</File>
          <File>tests/test_light_bulb.py</File>
        </AllowedWriteScope>
        <Verification>
          <Command>python -m pytest tests/test_light_bulb.py -v</Command>
        </Verification>
        <AcceptanceCriteria>
          <Criterion>LightBulb subscribes to 'motion_detected' on initialization.</Criterion>
          <Criterion>When motion detected, device is_on becomes True.</Criterion>
        </AcceptanceCriteria>
      </Slice>
    </Wave>

    <!-- WAVE 4: Smart Home Controller (Deep Context Injection) -->
    <Wave id="WAVE-CTRL-4">
      <Goal>Create SmartHomeHub that initializes bus, sensors, and actuators, and runs a simulation tick.</Goal>
      <ModuleRef id="M-CTRL" />
      <AllowedWriteScope>
        <File>src/controller.py</File>
        <File>tests/test_controller.py</File>
      </AllowedWriteScope>
      <FrozenScope>
        <File>src/models.py</File>
        <File>src/event_bus.py</File>
        <File>src/temp_sensor.py</File>
        <File>src/motion_sensor.py</File>
        <File>src/thermostat.py</File>
        <File>src/light_bulb.py</File>
      </FrozenScope>
      <Verification>
        <Command>python -m pytest tests/test_controller.py -v</Command>
      </Verification>
      <AcceptanceCriteria>
        <Criterion>controller.py imports EventBus, all sensors, and all actuators.</Criterion>
        <Criterion>SmartHomeHub has simulate_motion() which triggers motion sensor and results in LightBulb turning on.</Criterion>
        <Criterion>SmartHomeHub has simulate_cold_temp() which triggers temp sensor and results in Thermostat turning on.</Criterion>
      </AcceptanceCriteria>
    </Wave>

    <!-- WAVE 5: Application -->
    <Wave id="WAVE-APP-5">
      <Goal>Create main.py that runs a simulation and outputs device states as JSON.</Goal>
      <ModuleRef id="M-APP" />
      <AllowedWriteScope>
        <File>src/main.py</File>
        <File>tests/test_main.py</File>
      </AllowedWriteScope>
      <FrozenScope>
        <File>src/models.py</File>
        <File>src/event_bus.py</File>
        <File>src/temp_sensor.py</File>
        <File>src/motion_sensor.py</File>
        <File>src/thermostat.py</File>
        <File>src/light_bulb.py</File>
        <File>src/controller.py</File>
      </FrozenScope>
      <Verification>
        <Command>python -m pytest tests/test_main.py -v</Command>
      </Verification>
      <AcceptanceCriteria>
        <Criterion>main.py imports SmartHomeHub, runs simulations, and prints valid JSON with final device states.</Criterion>
      </AcceptanceCriteria>
    </Wave>
  </Phase>
</DevelopmentPlan>
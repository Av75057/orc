<DevelopmentPlan id="PLAN-SMARTHOME" version="2.0" last_review="2026-07-28">

  <Phase id="PHASE-SMARTHOME">
    <Goal>Implement event-driven Smart Home Automation System.</Goal>

    <Wave id="WAVE-CORE-1">
      <Goal>Stabilize core: data models and event bus.</Goal>
      <ModuleRef id="M-MODELS" />
      <ModuleRef id="M-EVENTBUS" />
      <AllowedWriteScope>
        <File>src/smart_home/__init__.py</File>
        <File>src/smart_home/models.py</File>
        <File>src/smart_home/event_bus.py</File>
        <File>tests/test_event_bus.py</File>
      </AllowedWriteScope>
      <FrozenScope>
        <File>src/smart_home/sensors.py</File>
        <File>src/smart_home/actuators.py</File>
        <File>src/smart_home/controller.py</File>
        <File>src/smart_home/main.py</File>
        <File>docs/*</File>
      </FrozenScope>
      <Verification>
        <Command>PYTHONPATH=src python -m pytest tests/test_event_bus.py -v</Command>
      </Verification>
      <AcceptanceCriteria>
        <Criterion>Event — frozen dataclass with topic and payload.</Criterion>
        <Criterion>EventBus.publish delivers to all subscribers.</Criterion>
        <Criterion>subscribe/unsubscribe work correctly.</Criterion>
        <Criterion>Subscriber error does not interrupt delivery.</Criterion>
        <Criterion>Duplicate subscribe is ignored.</Criterion>
      </AcceptanceCriteria>
      <DeferredWork><Item>Async delivery — deferred</Item></DeferredWork>
    </Wave>

    <Wave id="WAVE-SENSORS-2">

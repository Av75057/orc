<?xml version="1.0" encoding="UTF-8"?>
<DevelopmentPlan>
  <Phase id="PHASE-1">
    <Goal>Implement artifact-driven baseline for GRACE Orchestrator</Goal>
    <Wave id="WAVE-1">
      <Goal>Implement core data models and XML parser for development-plan.xml</Goal>
      <Modules>
        <Module>M-ARTIFACTS</Module>
        <Module>M-CORE</Module>
      </Modules>
      <AllowedWriteScope>
        <File>src/grace/models.py</File>
        <File>src/grace/artifact_loader.py</File>
        <File>tests/test_artifact_loader.py</File>
        <File>docs/development-plan.xml</File>
      </AllowedWriteScope>
      <FrozenScope>
        <File>src/grace/controller.py</File>
        <File>src/grace/reviewer.py</File>
        <File>src/grace/orchestrator.py</File>
        <File>infra/*</File>
        <File>frontend/*</File>
      </FrozenScope>
      <MustPreserve>
        <Item>Python 3.9+ compatibility</Item>
        <Item>Standard library only (xml.etree.ElementTree, dataclasses)</Item>
        <Item>No side effects on import</Item>
      </MustPreserve>
      <Verification>
        <Command>python -m pytest tests/test_artifact_loader.py -v</Command>
      </Verification>
    </Wave>
  </Phase>
</DevelopmentPlan>

<?xml version="1.0" encoding="UTF-8"?>
<DevelopmentPlan>
  <Phase id="PHASE-ECOM">
    <Goal>Build an E-commerce Order Processing System with parallel features and integration.</Goal>

    <!-- WAVE 1: Foundation -->
    <Wave id="WAVE-MODELS-1">
      <Goal>Create data models (Product, Order) and a simple in-memory storage engine.</Goal>
      <ModuleRef id="M-MODELS" />
      <AllowedWriteScope>
        <File>src/models.py</File>
        <File>src/storage.py</File>
        <File>tests/test_storage.py</File>
      </AllowedWriteScope>
      <Verification>
        <Command>python -m pytest tests/test_storage.py -v</Command>
      </Verification>
      <AcceptanceCriteria>
        <Criterion>models.py defines Product and Order dataclasses.</Criterion>
        <Criterion>storage.py provides Storage class with save and get methods.</Criterion>
      </AcceptanceCriteria>
    </Wave>

    <!-- WAVE 2: Parallel Multi-Agent Execution -->
    <Wave id="WAVE-FEATURES-2">
      <Goal>Develop discount calculator and notification modules in parallel.</Goal>
      
      <Slice id="SLICE-DISCOUNT">
        <Goal>Create discount.py providing calculate_discount(product, quantity).</Goal>
        <ModuleRef id="M-DISCOUNT" />
        <AllowedWriteScope>
          <File>src/discount.py</File>
          <File>tests/test_discount.py</File>
        </AllowedWriteScope>
        <Verification>
          <Command>python -m pytest tests/test_discount.py -v</Command>
        </Verification>
        <AcceptanceCriteria>
          <Criterion>discount.py calculates bulk purchase discounts correctly.</Criterion>
        </AcceptanceCriteria>
      </Slice>

      <Slice id="SLICE-NOTIFY">
        <Goal>Create notifier.py providing a Notifier class with send_email(order_id) method.</Goal>
        <ModuleRef id="M-NOTIFY" />
        <AllowedWriteScope>
          <File>src/notifier.py</File>
          <File>tests/test_notifier.py</File>
        </AllowedWriteScope>
        <Verification>
          <Command>python -m pytest tests/test_notifier.py -v</Command>
        </Verification>
        <AcceptanceCriteria>
          <Criterion>notifier.py outputs a simulated email to stdout.</Criterion>
        </AcceptanceCriteria>
      </Slice>
    </Wave>

    <!-- WAVE 3: Sequential Feature (Uses Context Injection from WAVE 1) -->
    <Wave id="WAVE-CART-3">
      <Goal>Create the ShoppingCart class that uses Storage and Models.</Goal>
      <ModuleRef id="M-CART" />
      <AllowedWriteScope>
        <File>src/cart.py</File>
        <File>tests/test_cart.py</File>
      </AllowedWriteScope>
      <FrozenScope>
        <File>src/models.py</File>
        <File>src/storage.py</File>
      </FrozenScope>
      <Verification>
        <Command>python -m pytest tests/test_cart.py -v</Command>
      </Verification>
      <AcceptanceCriteria>
        <Criterion>cart.py imports Storage and Product.</Criterion>
        <Criterion>ShoppingCart has add_item and checkout methods.</Criterion>
      </AcceptanceCriteria>
    </Wave>

    <!-- WAVE 4: Final Integration (Uses Context Injection from ALL waves) -->
    <Wave id="WAVE-INTEGRATION-4">
      <Goal>Integrate all modules into CheckoutService and write end-to-end tests.</Goal>
      <ModuleRef id="M-CHECKOUT" />
      <AllowedWriteScope>
        <File>src/checkout.py</File>
        <File>tests/test_checkout.py</File>
      </AllowedWriteScope>
      <FrozenScope>
        <File>src/models.py</File>
        <File>src/storage.py</File>
        <File>src/discount.py</File>
        <File>src/notifier.py</File>
        <File>src/cart.py</File>
      </FrozenScope>
      <Verification>
        <Command>python -m pytest tests/test_checkout.py -v</Command>
      </Verification>
      <AcceptanceCriteria>
        <Criterion>checkout.py imports ShoppingCart, calculate_discount, and Notifier.</Criterion>
        <Criterion>End-to-end test: adds items, applies discount, processes checkout, sends notification.</Criterion>
      </AcceptanceCriteria>
      <DeferredWork>
        <Item>Add REST API endpoints in a future phase.</Item>
      </DeferredWork>
    </Wave>
  </Phase>
</DevelopmentPlan>
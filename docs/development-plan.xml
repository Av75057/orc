      <Verification>
        <Command>PYTHONPATH=src python -m pytest tests/test_sensors.py -v</Command>
      </Verification>
      <AcceptanceCriteria>
        <Criterion>TemperatureSensor.read(value) publishes Event("sensor.temperature", value).</Criterion>
        <Criterion>MotionSensor.detect(bool) publishes Event("sensor.motion", bool).</Criterion>
        <Criterion>Sensors accept EventBus in constructor.</Criterion>
      </AcceptanceCriteria>
      <DeferredWork><Item>Sensor calibration — deferred</Item></DeferredWork>
    </Wave>

    <Wave id="WAVE-ACTUATORS-3">
